package-as: ImprovedForever

# One repo, one addon folder per module: each moves to the top of the zip
move-folders:
  ImprovedForever/ImprovedForever: ImprovedForever
  ImprovedForever/ImprovedForever_Controller: ImprovedForever_Controller
  ImprovedForever/ImprovedForever_Wheel: ImprovedForever_Wheel
  ImprovedForever/ImprovedForever_Vibration: ImprovedForever_Vibration
  ImprovedForever/ImprovedForever_Minimap: ImprovedForever_Minimap
  ImprovedForever/ImprovedForever_Map: ImprovedForever_Map
  ImprovedForever/ImprovedForever_Auction: ImprovedForever_Auction
  ImprovedForever/ImprovedForever_Junk: ImprovedForever_Junk
  ImprovedForever/ImprovedForever_Wiki: ImprovedForever_Wiki
  ImprovedForever/ImprovedForever_Journal: ImprovedForever_Journal

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - tools
  - dist
  - vendor
  - .gitmodules
  - .claude
  - .github
  - .gitignore
  - .env
  - tpl.lua
